# =====================================================================
# Quiz System & Assessment Platform - Environment Configuration Template
# =====================================================================
# For Production: Copy to .env, set NODE_ENV=production, and replace
# all placeholder secrets with cryptographically strong keys.
#
# Generate keys with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =====================================================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration
DATABASE_TYPE=sqlite
DATABASE_PATH=./data/quiz_system.db

# JWT Cryptographic Secrets (MUST be at least 32 characters in production)
JWT_ACCESS_SECRET=replace_with_secure_random_64_char_hex_secret_access_key
JWT_REFRESH_SECRET=replace_with_secure_random_64_char_hex_secret_refresh_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS & Trusted Origins (comma-separated for multiple production domains, NO wildcard)
CORS_ORIGIN=https://quiz.yourdomain.com,https://admin.yourdomain.com

# SMTP Email Delivery (Required for production email verification & password reset)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_smtp_api_key_or_password_here
SMTP_FROM=Quiz System <no-reply@yourdomain.com>

# Security & Diagnostic Controls
ENABLE_AUDIT_LOGGING=true
VITE_ENABLE_DEV_LOGINS=false

# Root Environment Template
# See server/.env.example for server variables

PORT=5000
NODE_ENV=development

# Database
DATABASE_TYPE=sqlite
DATABASE_PATH=./server/data/quiz_system.db

# JWT Secrets (Provide high-entropy 256-bit keys in production)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Email Delivery Integration (SMTP / Resend / SendGrid)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@quizsystem.io
